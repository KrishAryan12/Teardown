# Teardown configuration. Copy to .env for local development (never commit .env).
# On Vercel, add these under Project Settings > Environment Variables (keys are secrets there by default).
# On Vercel, serverless defaults apply to unset limits (see docs/DEPLOY.md). Defaults below are what the code uses when unset.

# ───────────────────────── Scanner: runtime ─────────────────────────
# production on the Space (set by the Dockerfile)
NODE_ENV=development
# HF Spaces expects 7860
PORT=7860
HOST=0.0.0.0
# Exact origins of the website, comma-separated, no trailing slash. "*" is refused in production.
ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies in front of the scanner whose X-Forwarded-For is trusted (HF Spaces: 1, local: 0 or 1).
TRUST_PROXY_HOPS=1
# Shown in the TeardownBot user agent so site owners can find you.
CONTACT_URL=https://github.com/KrishAryan12/Teardown
# DEV/TEST ONLY: allow scanning localhost/private ranges (for fixtures). Startup fails if true in production.
ALLOW_PRIVATE_TARGETS=false
# Chromium sandbox off inside unprivileged containers (see docs/SECURITY.md). Set false if your host allows it.
BROWSER_NO_SANDBOX=true

# ───────────────────────── Shared state (serverless) ─────────────────────────
# Upstash Redis (free, console.upstash.com): rate limits, daily budgets and the scan gate across
# serverless instances. Vercel's Upstash integration may name them KV_REST_API_URL / KV_REST_API_TOKEN.
# Without them, limits live in memory (fine locally, weak on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────── AI provider chain (all optional) ─────────────────────────
# Tried in this order; a provider without a key is skipped. No key at all = built-in fix text.
AI_PROVIDERS=gemini,groq,huggingface,openrouter
# Google AI Studio key (aistudio.google.com > Get API key). Secret.
GEMINI_API_KEY=
# Models are suggestions verified on 2026-10-04; confirm with `pnpm ai:eval`. Retired models are skipped automatically.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Groq key (console.groq.com > API Keys). Secret.
GROQ_API_KEY=
GROQ_MODELS=llama-3.1-8b-instant
# HuggingFace fine-grained token with "Make calls to Inference Providers". Secret. Uses the small monthly credit.
HF_TOKEN=
HF_MODELS=meta-llama/Llama-3.1-8B-Instruct:cheapest
# OpenRouter key. Secret. Only ":free" models are ever used.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
# Daily call budgets (UTC day). Global first, then per provider.
AI_DAILY_CALLS=400
AI_DAILY_CALLS_GEMINI=200
AI_DAILY_CALLS_GROQ=300
AI_DAILY_CALLS_HUGGINGFACE=20
AI_DAILY_CALLS_OPENROUTER=40
AI_TIMEOUT_MS=45000
# Total time the AI chain may spend per scan (all providers and retries).
AI_TOTAL_BUDGET_MS=120000

# ───────────────────────── Performance engine ─────────────────────────
# auto = PageSpeed Insights if PSI_API_KEY is set (and under cap), else local Lighthouse, else estimate.
# Also: psi | lighthouse | estimate
PERF_ENGINE=auto
# Optional Google PageSpeed Insights key. Secret. Not needed: local Lighthouse works without it.
PSI_API_KEY=
PSI_DAILY_CAP=500
# Local Lighthouse when PSI is unavailable (Docker). Off by default on Vercel, which does not ship it.
LIGHTHOUSE_ENABLED=true
LIGHTHOUSE_TIMEOUT_MS=90000
# Full-site mode: Lighthouse/PSI on the home page plus this many more pages.
PERF_MAX_PAGES_FULL=2

# ───────────────────────── Abuse protection and limits ─────────────────────────
# Optional Cloudflare Turnstile secret. When set, POST /api/scan requires a valid token. Secret.
TURNSTILE_SECRET=
# single-page scans per IP per hour
SINGLE_PER_HOUR=5
# single-page scans per IP per day
SINGLE_PER_DAY=15
# full-site scans per IP per day
SITE_PER_DAY=1
# scans of one target domain per day, all users
DOMAIN_PER_DAY=10
# all single-page scans per day
GLOBAL_SINGLE_PER_DAY=600
# all full-site scans per day (0 disables full-site mode)
GLOBAL_SITE_PER_DAY=40
# PDF exports per IP per hour
PDF_PER_HOUR=10
# lower to 1 on small hosts
MAX_CONCURRENT_SCANS=2
# waiting scans before QUEUE_FULL
MAX_QUEUE=15
# report payload cap (screenshots dropped first) and PDF body limit
REPORT_MAX_BYTES=10485760
# report cache: 6 hours
CACHE_TTL_MS=21600000
CACHE_MAX_ENTRIES=100
CACHE_MAX_BYTES=209715200

# ───────────────────────── Scan caps ─────────────────────────
SITE_MAX_PAGES=15
SITE_CONCURRENCY=2
# full-site total budget: 6 minutes
SITE_BUDGET_MS=360000
NAV_TIMEOUT_MS=25000
PAGE_BUDGET_MS=40000
MAX_HTML_BYTES=5242880
MAX_SUBREQUESTS=400
# Hard ceiling for one scan in ms (Vercel default 270000, under its 300 s limit).
SCAN_DEADLINE_MS=1800000
# 1 = force the serverless Chromium build, 0 = force Playwright's. Auto-detected from VERCEL otherwise.
CHROMIUM_SERVERLESS=

# ───────────────────────── Web ─────────────────────────
# Leave empty: the site calls its own /api. Set only to use a separate Docker scanner, e.g. https://scanner.example
NEXT_PUBLIC_SCANNER_URL=
# Public URL of the website itself (canonical and Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
